  "compilerOptions": {
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "node",
    "module": "commonjs",
    "target": "es2020"
  },
  "include": [
    "src/**/*",
    "app/**/*",
    "jest.setup.ts"
  ]
}
